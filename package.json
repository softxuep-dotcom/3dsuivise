{
  "name": "last-truck-out",
  "private": true,
  "version": "1.1.38",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "build:poki": "vite build --mode poki",
    "package:poki": "npm run build:poki && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-poki.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "vitest run --config vitest.probes.config.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
